+/*-----------------REMESH_POOR_OXIDE------------------------------------
+ * Sentaurus-style safety net for the compress model (poly re-oxidation):
+ * before velocities are computed, an oxide region whose worst triangle has
+ * quality below SUPREM4_OXIDE_REMESH_QUALITY (default 0.02, "0" disables)
+ * is retriangulated from its unchanged boundary and its fields are
+ * interpolated.  New nodes take their interpolated velocity as history.
+ *----------------------------------------------------------------------*/
+int remesh_poor_oxide()
+{
+    const char *opt = suprem_option("SUPREM4_OXIDE_REMESH_QUALITY");
+    double qmin = opt ? atof(opt) : 0.0, q, worst;
+    int r, i, t, nr, changed = 0, k, n;
+    int xv = imptosol[XVEL], yv = imptosol[YVEL];
+    int before_nn, attempted = 0;
+    if (mode != TWOD || oxide_model != O_ELASTIC || qmin <= 0 || xv < 0) return 0;
+    nr = nreg;
+    for (r = 0; r < nr; r++) {
+	if (reg[r] == NULL || mat_reg(r) != SiO2 || num_tri_reg(r) == 0) continue;
+	worst = 1.0;
+	for (i = 0; i < num_tri_reg(r); i++) {
+	    t = tri_reg(r, i);
+	    if (dead_tri(t)) continue;
+	    q = remesh_tri_quality(t);
+	    if (q < worst) worst = q;
+	}
+	if (worst >= qmin) continue;
+	if (getenv("SUPREM4_MESH_DIAG")) {
+	    for (i = 0; i < num_tri_reg(r); i++) {
+		t = tri_reg(r, i);
+		if (dead_tri(t) || remesh_tri_quality(t) > worst) continue;
+		fprintf(stderr, "[oxide-remesh] worst tri=%d", t);
+		for (k = 0; k < 3; k++) { int q_ = pt_nd(vert_tri(t,k));
+		    fprintf(stderr, " (%.6f,%.6f nn=%d surf=%d nb=%d)", 1e4*xcord(q_), 1e4*ycord(q_), num_nd(q_), (is_surf(q_))?1:0, tri[t]->nb[k]); }
+		fprintf(stderr, "\n");
+		break;
+	    }
+	}
+	before_nn = nn;
+	if (remesh_region_preserve(r)) {
+	    changed++;
+	    if (getenv("SUPREM4_MESH_DIAG"))
+		fprintf(stderr, "[oxide-remesh] region %d worst quality %.3g < %.3g\n", r, worst, qmin);
+	    /* velocity history for new nodes = interpolated current velocity */
+	    for (n = before_nn; n < nn; n++) {
+		if (dead_nd(n)) continue;
+		nd[n]->sol[MAXIMP-5] = nd[n]->sol[xv];
+		nd[n]->sol[MAXIMP-6] = nd[n]->sol[yv];
+	    }
+	}
+	else {
+	    attempted++;
+	    if (getenv("SUPREM4_MESH_DIAG"))
+		fprintf(stderr, "[oxide-remesh] region %d worst quality %.3g: remesh rejected\n", r, worst);
+	}
+    }
+    /* A rejected candidate leaves dead points to collect. */
+    if (attempted && !changed) { bd_connect("oxide remesh rejected"); UpdateSymbolic++; }
+    if (changed) {
+	bd_connect("oxide quality remesh");
+	UpdateSymbolic++;
+    }
+    return changed;
+}
