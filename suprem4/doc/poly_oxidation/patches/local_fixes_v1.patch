+/*-----------------RELABEL_SLIVERS--------------------------------------
+ * TSUPREM-4 remedy for a thin triangle of one material protruding into
+ * another: "the material type of the triangle is changed to that of the
+ * surrounding structure".  During oxidation a consumed (poly)silicon
+ * triangle whose three vertices all lie on the oxide interface can
+ * collapse to a sliver that no interface-preserving removal can delete.
+ * Such a triangle is rebuilt from the oxide nodes at its points in the
+ * adjacent oxide region; the dopant it held (area ~1e-13 um^2) is dropped.
+ * Polysilicon only by default; SUPREM4_SLIVER_RELABEL=all includes Si,
+ * =0 disables.  Returns the number of triangles relabelled.
+ *----------------------------------------------------------------------*/
+int relabel_slivers()
+{
+    const char *opt = suprem_option("SUPREM4_SLIVER_RELABEL");
+    int with_si = opt && !strcmp(opt, "all");
+    int ie, j, n, k, m, rox, count = 0, v[3], b[3];
+    double q;
+    if (mode != TWOD || !opt || oxide_model != O_ELASTIC) return 0;
+    for (ie = 0; ie < ne; ie++) {
+	if (dead_tri(ie)) continue;
+	m = mat_reg(reg_tri(ie));
+	if (!(m == Poly || (with_si && m == Si))) continue;
+	for (j = 0; j < 3; j++)
+	    if (node_mat(vert_tri(ie,j), SiO2) < 0) break;
+	if (j < 3) continue;
+	q = remesh_tri_quality(ie);
+	if (q >= 1.0e-3) continue;
+	/* Oxide region across one of the faces */
+	rox = -1;
+	for (k = 0; k < num_face(ie) && rox < 0; k++) {
+	    n = neigh_fc(ie, k);
+	    if (n >= 0 && !dead_tri(n) && mat_reg(reg_tri(n)) == SiO2) rox = reg_tri(n);
+	}
+	if (rox < 0) continue;
+	for (j = 0; j < 3; j++) { v[j] = node_mat(vert_tri(ie,j), SiO2); b[j] = BC_OFFSET; }
+	if (getenv("SUPREM4_MESH_DIAG"))
+	    fprintf(stderr, "[sliver-relabel] tri=%d material=%d quality=%.3g -> oxide region %d\n",
+		    ie, m, q, rox);
+	(void)mk_ele(3, v, 3, b, rox, FALSE);
+	rem_ele(ie, FALSE);
+	count++;
+    }
+    if (count) {
+	bd_connect("sliver relabel");
+	UpdateSymbolic++;
+    }
+    return count;
+}
