+/*-----------------ZIP_OXIDE_NOTCHES------------------------------------
+ * Compress model (poly re-oxidation): in the concave corner beside a gate
+ * the sidewall oxide and the oxide over the substrate grow into a narrow
+ * gas notch until its sides collide.  Physically the oxide fuses.  When the
+ * gas angle at an oxide surface point T falls below ~40 degrees, the wedge
+ * between T and its two surface neighbours A, B is filled with an oxide
+ * triangle and T becomes interior.  Returns the number of notches zipped.
+ *----------------------------------------------------------------------*/
+static double zip_angle(int t, int n)
+{
+    int j, a, b, c;
+    double ux, uy, vx, vy;
+    for (j = 0; j < 3; j++) if (vert_tri(t,j) == n) break;
+    a = pt_nd(vert_tri(t,j)); b = pt_nd(vert_tri(t,(j+1)%3)); c = pt_nd(vert_tri(t,(j+2)%3));
+    ux = xcord(b) - xcord(a); uy = ycord(b) - ycord(a);
+    vx = xcord(c) - xcord(a); vy = ycord(c) - ycord(a);
+    return fabs(atan2(ux*vy - uy*vx, ux*vx + uy*vy));
+}
+static double zip_orient(int a, int b, int c)
+{
+    return ((double)xcord(b)-xcord(a))*((double)ycord(c)-ycord(a)) -
+	   ((double)ycord(b)-ycord(a))*((double)xcord(c)-xcord(a));
+}
+static int zip_ox_node(int p)
+{
+    int k;
+    for (k = 0; k < num_nd(p); k++) if (mat_nd(nd_pt(p,k)) == SiO2) return nd_pt(p,k);
+    return -1;
+}
+static double zip_dist(int a, int b)
+{
+    return hypot((double)xcord(a)-xcord(b), (double)ycord(a)-ycord(b));
+}
+/* Oxide triangle on points a,b,c (any order) if proper and empty. */
+static int zip_add(int a, int b, int c, int r)
+{
+    int v[3], bb[3], q, t;
+    if (zip_orient(a, b, c) < 0) { t = b; b = c; c = t; }
+    if (zip_orient(a, b, c) <= 0) return -1;
+    for (q = 0; q < np; q++) {
+	if (q == a || q == b || q == c || dead_pt(q)) continue;
+	if (zip_orient(a, b, q) >= 0 && zip_orient(b, c, q) >= 0 && zip_orient(c, a, q) >= 0) return -1;
+    }
+    v[0] = zip_ox_node(a); v[1] = zip_ox_node(b); v[2] = zip_ox_node(c);
+    if (v[0] < 0 || v[1] < 0 || v[2] < 0) return -1;
+    bb[0] = bb[1] = bb[2] = BC_OFFSET;
+    return mk_ele(3, v, 3, bb, r, FALSE);
+}
+int zip_oxide_notches()
+{
+    int *next, *prev, *used, t, j, n, a, b, tip, q, k, rox, count = 0;
+    int consumed[128], nc, L, R, nL, nR, last, iter;
+    double oxang, minang = 1.0;	/* ~57 degrees: concave oxide corners round into a fillet */
+    double gap = 2.0e-7;		/* 20 A: walls this close are in contact */
+    const char *g = getenv("SUPREM4_ZIP_GAP_UM");
+    if (mode != TWOD || oxide_model != O_ELASTIC || !suprem_option("SUPREM4_INTERFACE_MERGE")) return 0;
+    if (g && *g) gap = 1e-4 * atof(g);
+    next = salloc(int, np); prev = salloc(int, np); used = scalloc(int, np);
+    for (q = 0; q < np; q++) next[q] = prev[q] = -1;
+    /* Directed exposed oxide edges, oxide on the left. */
+    for (t = 0; t < ne; t++) {
+	if (dead_tri(t) || mat_reg(reg_tri(t)) != SiO2) continue;
+	for (j = 0; j < 3; j++) {
+	    if (!(is_face_exp(t,j))) continue;
+	    a = pt_nd(nd_face_ele(t,j,0)); b = pt_nd(nd_face_ele(t,j,1));
+	    if (zip_orient(a, b, pt_nd(vert_tri(t,j))) < 0) { k = a; a = b; b = k; }
+	    next[a] = b; prev[b] = a;
+	}
+    }
+    for (tip = 0; tip < np; tip++) {
+	if (dead_pt(tip) || next[tip] < 0 || prev[tip] < 0 || used[tip]) continue;
+	if (num_nd(tip) != 2 || is_back(tip)) continue;
+	n = zip_ox_node(tip);
+	if (n < 0 || node_mat(n, GAS) < 0) continue;
+	L = prev[tip]; R = next[tip];
+	if (L == R || used[L] || used[R] || zip_ox_node(L) < 0 || zip_ox_node(R) < 0) continue;
+	oxang = 0;
+	for (k = 0; k < num_tri_nd(n); k++) oxang += zip_angle(tri_nd(n,k), n);
+	if (getenv("SUPREM4_ZIP_DIAG") && (2*PI - oxang < 1.2 || zip_dist(L,R) < 2*gap))
+	    fprintf(stderr, "[notch-check] point=%d (%.6f,%.6f) gas angle %.3g gap %.3g um\n",
+		    tip, 1e4*xcord(tip), 1e4*ycord(tip), 2*PI - oxang, 1e4*zip_dist(L,R));
+	if (2*PI - oxang >= minang) continue;
+	/* A concave tip needs the gas on the inside of L-tip-R. */
+	if (2*PI - oxang > PI) continue;
+	rox = reg_tri(tri_nd(n,0));
+	if ((last = zip_add(L, tip, R, rox)) < 0) continue;
+	nc = 0; consumed[nc++] = tip;
+	/* Zipper along both walls while they are in contact. */
+	for (iter = 0; iter < 60 && nc < 120; iter++) {
+	    nL = prev[L]; nR = next[R];
+	    if (zip_dist(L, R) >= gap || nL < 0 || nR < 0 || nL == R || nR == L || nL == nR) break;
+	    if (used[nL] || used[nR] || zip_ox_node(nL) < 0 || zip_ox_node(nR) < 0) break;
+	    if (zip_dist(nL, R) <= zip_dist(L, nR)) {
+		if ((t = zip_add(nL, L, R, rox)) >= 0) { last = t; consumed[nc++] = L; L = nL; continue; }
+		if ((t = zip_add(L, R, nR, rox)) >= 0) { last = t; consumed[nc++] = R; R = nR; continue; }
+	    }
+	    else {
+		if ((t = zip_add(L, R, nR, rox)) >= 0) { last = t; consumed[nc++] = R; R = nR; continue; }
+		if ((t = zip_add(nL, L, R, rox)) >= 0) { last = t; consumed[nc++] = L; L = nL; continue; }
+	    }
+	    break;
+	}
+	/* The last cross edge L-R is the new surface. */
+	for (j = 0; j < 3; j++) {
+	    int pj = pt_nd(vert_tri(last,j));
+	    if (pj != L && pj != R) set_face_exp(last, j);
+	}
+	for (k = 0; k < nc; k++) {
+	    int c = consumed[k], on = zip_ox_node(c), gn = on >= 0 ? node_mat(on, GAS) : -1;
+	    clr_surf(c);
+	    if (gn >= 0) rem_1nd(gn);
+	    used[c] = 1;
+	}
+	used[L] = used[R] = 1;
+	count++;
+	if (getenv("SUPREM4_MESH_DIAG"))
+	    fprintf(stderr, "[notch-zip] point=%d (%.6f,%.6f) gas angle %.3g, %d wall points closed\n",
+		    tip, 1e4*xcord(tip), 1e4*ycord(tip), 2*PI - oxang, nc);
+    }
+    free(next); free(prev); free(used);
+    if (count) {
+	neigh_dirty = TRUE;
+	bd_connect("oxide notch zip");
+	UpdateSymbolic++;
+    }
+    return count;
+}
