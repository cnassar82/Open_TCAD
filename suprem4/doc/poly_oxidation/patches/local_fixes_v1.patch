+/*-----------------CONTACT_ZIP------------------------------------------
+ * Compress model: an oxide surface point P within SUPREM4_CONTACT_GAP_UM
+ * (default 0.003 um) of a non-adjacent oxide surface segment A-B across gas
+ * is in contact.  The small gas pocket between the contact and the slit tip
+ * (the surface path P..A or B..P, at most 40 points and 0.1 um perimeter)
+ * is filled with oxide by ear clipping; its inner wall points become interior.
+ *----------------------------------------------------------------------*/
+static double seg_dist(int p, int a, int b)
+{
+    double ax = xcord(a), ay = ycord(a), bx = xcord(b), by = ycord(b), px = xcord(p), py = ycord(p);
+    double dx = bx-ax, dy = by-ay, l2 = dx*dx+dy*dy, u;
+    if (l2 <= 0) return HUGE_VAL;
+    u = ((px-ax)*dx + (py-ay)*dy) / l2;
+    if (u < 0 || u > 1) return HUGE_VAL;
+    return fabs(dx*(py-ay) - dy*(px-ax)) / sqrt(l2);
+}
+int contact_zip()
+{
+    int *next, *prev, t, j, a, b, k, q, cp, ca, cb, count = 0;
+    int poly[48], n, dir, steps, rox, best_p = -1, best_a = -1, best_b = -1, made, guard;
+    double d, best = HUGE_VAL, gap = 3.0e-7, per;
+    const char *g = getenv("SUPREM4_CONTACT_GAP_UM");
+    if (mode != TWOD || oxide_model != O_ELASTIC || !suprem_option("SUPREM4_INTERFACE_MERGE")) return 0;
+    if (g && *g) gap = 1e-4 * atof(g);
+    next = salloc(int, np); prev = salloc(int, np);
+    for (q = 0; q < np; q++) next[q] = prev[q] = -1;
+    for (t = 0; t < ne; t++) {
+	if (dead_tri(t) || mat_reg(reg_tri(t)) != SiO2) continue;
+	for (j = 0; j < 3; j++) {
+	    if (!(is_face_exp(t,j))) continue;
+	    a = pt_nd(nd_face_ele(t,j,0)); b = pt_nd(nd_face_ele(t,j,1));
+	    if (zip_orient(a, b, pt_nd(vert_tri(t,j))) < 0) { k = a; a = b; b = k; }
+	    next[a] = b; prev[b] = a;
+	}
+    }
+    /* closest contact */
+    for (cp = 0; cp < np; cp++) {
+	if (dead_pt(cp) || next[cp] < 0 || prev[cp] < 0 || num_nd(cp) != 2) continue;
+	for (ca = 0; ca < np; ca++) {
+	    cb = next[ca];
+	    if (cb < 0 || ca == cp || cb == cp || ca == prev[cp] || cb == next[cp]) continue;
+	    if (zip_orient(ca, cb, cp) >= 0) continue;		/* cp must be on the gas side */
+	    d = seg_dist(cp, ca, cb);
+	    if (d < gap && d < best) { best = d; best_p = cp; best_a = ca; best_b = cb; }
+	}
+    }
+    if (best_p >= 0) {
+	cp = best_p; ca = best_a; cb = best_b;
+	/* pocket: cp -> ... -> ca (forward) or cb -> ... -> cp (forward), shorter */
+	for (dir = 0; dir < 2; dir++) {
+	    int start = dir ? cb : cp, end = dir ? cp : ca;
+	    n = 0; q = start; per = 0;
+	    for (steps = 0; steps < 40 && q >= 0; steps++) {
+		poly[n++] = q;
+		if (q == end) break;
+		if (next[q] >= 0) per += zip_dist(q, next[q]);
+		q = next[q];
+	    }
+	    if (q == end && n >= 3 && per < 1e-5) break;
+	    n = 0;
+	}
+	if (n >= 3) {
+	    int c0 = poly[0], c1 = poly[n-1];
+	    rox = -1;
+	    { int on = zip_ox_node(cp); if (on >= 0 && num_tri_nd(on) > 0) rox = reg_tri(tri_nd(on,0)); }
+	    /* polygon orientation: make it positive (counter-clockwise) */
+	    { double ar = 0; for (k = 0; k < n; k++) { int u = poly[k], w = poly[(k+1)%n];
+		ar += (double)xcord(u)*ycord(w) - (double)xcord(w)*ycord(u); }
+	      if (ar < 0) for (k = 0; k < n/2; k++) { int tmp = poly[k]; poly[k] = poly[n-1-k]; poly[n-1-k] = tmp; } }
+	    made = 0;
+	    for (guard = 0; n > 3 && guard < 200 && rox >= 0; guard++) {
+		int ok = 0;
+		for (k = 0; k < n; k++) {
+		    int u = poly[(k+n-1)%n], w = poly[k], x = poly[(k+1)%n];
+		    if (zip_orient(u, w, x) <= 0) continue;
+		    if (zip_add(u, w, x, rox) < 0) continue;
+		    made++;
+		    for (j = k; j < n-1; j++) poly[j] = poly[j+1];
+		    n--; ok = 1; break;
+		}
+		if (!ok) break;
+	    }
+	    if (n == 3 && rox >= 0 && zip_add(poly[0], poly[1], poly[2], rox) >= 0) { made++; n = 0; }
+	    if (made) {
+		/* the closing chord c0-c1 is the new surface; others are interior */
+		int last = ne - 1, w;
+		for (j = 0; j < 3; j++) {
+		    int pj = pt_nd(vert_tri(last,j));
+		    if (pj != c0 && pj != c1) {
+			int u2 = pt_nd(vert_tri(last,(j+1)%3)), w2 = pt_nd(vert_tri(last,(j+2)%3));
+			if ((u2 == c0 && w2 == c1) || (u2 == c1 && w2 == c0)) set_face_exp(last, j);
+		    }
+		}
+		/* inner wall points become interior oxide */
+		q = (c0 == cp) ? next[cp] : next[cb];
+		for (w = 0; w < 40 && q >= 0 && q != c1; w++) {
+		    int on = zip_ox_node(q), gn = on >= 0 ? node_mat(on, GAS) : -1;
+		    int nq = next[q];
+		    clr_surf(q);
+		    if (gn >= 0) rem_1nd(gn);
+		    q = nq;
+		}
+		count++;
+		if (getenv("SUPREM4_MESH_DIAG"))
+		    fprintf(stderr, "[contact-zip] point (%.6f,%.6f) %.3g um from wall: %d triangles\n",
+			    1e4*xcord(cp), 1e4*ycord(cp), 1e4*best, made);
+	    }
+	}
+    }
+    free(next); free(prev);
+    if (count) {
+	neigh_dirty = TRUE;
+	bd_connect("oxide contact zip");
+	UpdateSymbolic++;
+    }
+    return count;
+}
