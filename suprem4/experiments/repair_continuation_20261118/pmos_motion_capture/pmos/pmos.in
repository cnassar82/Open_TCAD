option quiet
method fermi vertical grid.oxide=0.04
oxide Vc=300 Vr=30 Vd=25 stress.dep=true
method viscous oxide.rel=1e-2 grid.oxide=0.04
structure infile=locos.str
# Thin post-LOCOS oxides: vertical growth approximation.
method fermi vertical grid.oxide=0.04
# PDF p.73: 311 sacrificial Kooi oxide; ramps discretized in <=50 C intervals.
diffuse time=12 temp=800 nitrogen dump=10
diffuse time=15 temp=800 nitrogen continue dump=10
diffuse time=5 temp=825 dryo2 dump=10
diffuse time=5 temp=875 dryo2 continue dump=10
diffuse time=5 temp=900 dryo2 continue dump=10
diffuse time=40 temp=900 weto2 continue dump=10
diffuse time=5 temp=900 nitrogen continue dump=10
diffuse time=7.5 temp=875 nitrogen continue dump=10
diffuse time=7.5 temp=825 nitrogen continue dump=10
diffuse time=15 temp=800 nitrogen continue dump=10
implant boron dose=7e+11 energy=60 pearson
implant boron dose=2.6e+12 energy=60 pearson
structure outfile=threshold.str
quit
