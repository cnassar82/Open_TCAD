+/* Conforming quality refinement. Preserve the material partition and every
+ * old point; resolve short boundary segments by grading the interior mesh
+ * rather than merging distinct vertices or moving the boundary. */
+static double mesh_triangle_quality(int t)
+{
+    float *a=cord_arr(pt_nd(vert_tri(t,0))),*b=cord_arr(pt_nd(vert_tri(t,1))),*c=cord_arr(pt_nd(vert_tri(t,2)));
+    double ax=(double)b[0]-a[0],ay=(double)b[1]-a[1];
+    double bx=(double)c[0]-a[0],by=(double)c[1]-a[1];
+    double cx=(double)c[0]-b[0],cy=(double)c[1]-b[1];
+    return 2*sqrt(3.)*(ax*by-ay*bx)/(ax*ax+ay*ay+bx*bx+by*by+cx*cx+cy*cy);
+}
+static int mesh_admissible_midpoint(int e,float *c)
+{
+    int i,j,k,t,a,b;float v[3][MAXDIM];
+    for(j=0;j<MAXDIM;j++)c[j]=0;
+    for(j=0;j<2;j++)c[j]=.5*((double)cordinate(pt_edg(e,0),j)+cordinate(pt_edg(e,1),j));
+    for(i=0;i<num_tri_edg(e);i++) {
+        t=tri_edg(e,i);if(dead_tri(t) || !leaf(tri[t]))continue;
+        for(a=0;a<3;a++)if(vert_tri(t,a)==nd_edg(e,0))break;
+        for(b=0;b<3;b++)if(vert_tri(t,b)==nd_edg(e,1))break;
+        if(a==3 || b==3)return FALSE;
+        for(k=0;k<3;k++)memcpy(v[k],cord_arr(pt_nd(vert_tri(t,k))),sizeof(v[k]));
+        memcpy(v[a],c,sizeof(v[a]));
+        if(orient2d_float_sign(v[0],v[1],v[2])<=0)return FALSE;
+        memcpy(v[a],cord_arr(pt_nd(vert_tri(t,a))),sizeof(v[a]));
+        memcpy(v[b],c,sizeof(v[b]));
+        if(orient2d_float_sign(v[0],v[1],v[2])<=0)return FALSE;
+    }
+    return TRUE;
+}
+int refine_mesh_quality(double minimum)
+{
+    int t,worst,e,point,node,i,j,k,r,owner,onedge,count=0,limit=np*4+100;
+    int n[3],oldv[3],children[3];
+    double q,worstq,length,shortest,x,y,dx,dy,area,w[3],value,height,seedq;
+    float c[MAXDIM],*a,*b,*p[3];
+    if(mode!=TWOD)return 0;
+    if(!(minimum>0 && minimum<1))return -1;
+    for(;;) {
+        worst=-1;worstq=minimum;
+        for(t=0;t<ne;t++) {
+            if(dead_tri(t) || !leaf(tri[t]))continue;
+            q=mesh_triangle_quality(t);
+            if(q<worstq){worstq=q;worst=t;}
+        }
+        if(worst<0)break;
+        if(count>=limit)goto unresolved;
+        r=reg_tri(worst);shortest=DBL_MAX;e=-1;
+        for(i=0;i<3;i++) {
+            a=cord_arr(pt_nd(vert_tri(worst,i)));
+            b=cord_arr(pt_nd(vert_tri(worst,(i+1)%3)));
+            length=hypot((double)b[0]-a[0],(double)b[1]-a[1]);
+            if(length<shortest){shortest=length;e=i;}
+        }
+        a=cord_arr(pt_nd(vert_tri(worst,e)));
+        b=cord_arr(pt_nd(vert_tri(worst,(e+1)%3)));
+        dx=(double)b[0]-a[0];dy=(double)b[1]-a[1];
+        /* Off-center insertion near the shortest edge. Locate in the
+         * entire region, not just the needle: its rounded off-center can
+         * lie across an unconstrained diagonal. No boundary is split or
+         * moved unless the stored point lies exactly on an existing edge. */
+        /* Choose the off-center from the requested quality, rather than
+         * generating equilateral microcells regardless of that request.
+         * For base L and height s*L, q=2*sqrt(3)*s/(1.5+2*s*s). */
+        height=(sqrt(3.)+sqrt(3.-3.*minimum*minimum))/(2.*minimum);
+        {
+            float *opposite=cord_arr(pt_nd(vert_tri(worst,(e+2)%3)));
+            double vx=(double)opposite[0]-.5*((double)a[0]+b[0]);
+            double vy=(double)opposite[1]-.5*((double)a[1]+b[1]);
+            double circle_height=(vx*vx+vy*vy-.25*(dx*dx+dy*dy))/(2*(dx*vy-dy*vx));
+            if(circle_height>0 && circle_height<height)height=circle_height;
+        }
+        for(k=0;k<32;k++,height*=.5) {
+            double ex,ey,fx,fy;
+            c[0]=.5*((double)a[0]+b[0])-height*dy;
+            c[1]=.5*((double)a[1]+b[1])+height*dx;c[2]=0;
+            ex=(double)c[0]-a[0];ey=(double)c[1]-a[1];
+            fx=(double)c[0]-b[0];fy=(double)c[1]-b[1];
+            seedq=2*sqrt(3.)*(dx*ey-dy*ex)/(dx*dx+dy*dy+ex*ex+ey*ey+fx*fx+fy*fy);
+            if(seedq>=minimum && orient2d_float_sign(a,b,c)>0)break;
+        }
+        if(k==32)goto unresolved;
+        /* A candidate may encroach on a long constrained segment next
+         * to the short edge. Split the segment first (Ruppert protection),
+         * otherwise inserting the off-center simply creates another needle. */
+        onedge=-1;shortest=0;
+        for(e=0;e<ned;e++) {
+            int constrained=num_tri_edg(e)==1,belongs=0;
+            if(dead_edg(e))continue;
+            for(i=0;i<num_tri_edg(e);i++) {
+                int t0=tri_edg(e,i);
+                if(reg_tri(t0)==r)belongs=1;
+                else constrained=1;
+            }
+            if(!constrained || !belongs)continue;
+            a=cord_arr(pt_edg(e,0));b=cord_arr(pt_edg(e,1));
+            if(((double)c[0]-a[0])*((double)c[0]-b[0])+
+               ((double)c[1]-a[1])*((double)c[1]-b[1])>=0)continue;
+            if(len_edg(e)>shortest){shortest=len_edg(e);onedge=e;}
+        }
+        if(onedge>=0) {
+            if(!mesh_admissible_midpoint(onedge,c))goto unresolved;
+            if(sp_edge_keep(onedge,c,&point,FALSE,nd_edg(onedge,0))<0)goto unresolved;
+            count++;bd_connect("protected quality segment refinement");UpdateSymbolic++;
+            continue;
+        }
+        owner=-1;onedge=-1;
+        for(t=0;t<ne;t++) {
+            int side[3];
+            if(dead_tri(t) || !leaf(tri[t]) || reg_tri(t)!=r)continue;
+            for(i=0;i<3;i++)p[i]=cord_arr(pt_nd(vert_tri(t,i)));
+            for(i=0;i<3;i++)side[i]=orient2d_float_sign(p[i],p[(i+1)%3],c);
+            if(side[0]<0 || side[1]<0 || side[2]<0)continue;
+            for(i=0;i<3;i++)if(c[0]==p[i][0] && c[1]==p[i][1])goto unresolved;
+            owner=t;
+            for(i=0;i<3;i++)if(side[i]==0)onedge=edg_ele(t,(i+2)%3);
+            break;
+        }
+        if(owner<0)goto unresolved;
+        if(onedge>=0) {
+            if(sp_edge_keep(onedge,c,&point,FALSE,nd_edg(onedge,0))<0)goto unresolved;
+        }
+        else {
+            for(i=0;i<3;i++){oldv[i]=vert_tri(owner,i);p[i]=cord_arr(pt_nd(oldv[i]));}
+            area=((double)p[1][0]-p[0][0])*((double)p[2][1]-p[0][1])-
+                 ((double)p[1][1]-p[0][1])*((double)p[2][0]-p[0][0]);
+            x=c[0];y=c[1];
+            w[0]=(((double)p[1][0]-x)*((double)p[2][1]-y)-((double)p[1][1]-y)*((double)p[2][0]-x))/area;
+            w[1]=(((double)p[2][0]-x)*((double)p[0][1]-y)-((double)p[2][1]-y)*((double)p[0][0]-x))/area;
+            w[2]=1-w[0]-w[1];
+            if(w[0]<0 || w[1]<0 || w[2]<0)goto unresolved;
+            point=mk_pt(2,c);set_space(point,shortest);node=mk_nd(point,mat_reg(r));
+            for(j=0;j<n_imp;j++) {
+                value=0;for(i=0;i<3;i++)value+=w[i]*sol_nd(oldv[i],j);
+                set_sol_nd(node,j,value);
+            }
+            for(i=0;i<3;i++) {
+                n[0]=oldv[i];n[1]=oldv[(i+1)%3];n[2]=node;
+                children[i]=mk_ele_nd(3,n,r);
+                if(tri[owner]->nb[(i+2)%3]<0)tri[children[i]]->nb[2]=tri[owner]->nb[(i+2)%3];
+            }
+            rem_ele(owner,FALSE);
+        }
+        count++;bd_connect("conforming off-center refinement");UpdateSymbolic++;
+        if(count%100==0)fprintf(stderr,"[quality-progress] inserted=%d old_q=%g points=%d\n",count,worstq,np);
+    }
+    if(count)fprintf(stderr,"[quality] inserted=%d target=%g points=%d\n",count,minimum,np);
+    return 0;
+unresolved:
+    fprintf(stderr,"ERROR: quality refinement unresolved triangle=%d q=%g insertions=%d\n",worst,worstq,count);
+    return -1;
+}
+
