option quiet
method fermi vertical grid.oxide=0.04
oxide Vc=300 Vr=30 Vd=25 stress.dep=true
method viscous oxide.rel=1e-2 grid.oxide=0.04
method fermi vertical grid.oxide=0.04
structure infile=poly_doped.str
etch poly left p1.x=5.5
etch poly right p1.x=6.5
structure outfile=gate.str
deposit photoresist thick=1.5 divisions=6
etch photoresist start x=3 y=-5
etch continue x=3 y=1
etch continue x=9 y=1
etch done x=9 y=-5
implant phosphorus dose=2.5e+13 energy=60 pearson
etch photoresist all
structure outfile=ldd.str
deposit oxide thick=0.5 divisions=10 space=0.04
etch oxide dry thick=0.5
structure outfile=spacers.str
deposit photoresist file=resist_top.dat divisions=8
etch photoresist start x=3 y=-5
etch continue x=3 y=1
etch continue x=9 y=1
etch done x=9 y=-5
implant phosphorus dose=2e+15 energy=60 pearson
etch photoresist all
deposit photoresist file=resist_top.dat divisions=8
etch photoresist start x=0.5 y=-5
etch continue x=0.5 y=1
etch continue x=2 y=1
etch done x=2 y=-5
implant boron dose=2e+15 energy=50 pearson
etch photoresist all
structure outfile=source_drain.str
# PDF p.116: 280 source/drain activation; ramps discretized in <=50 C intervals.
diffuse time=12 temp=800 nitrogen
diffuse time=15 temp=800 nitrogen continue
diffuse time=5 temp=825 dryo2
diffuse time=5 temp=875 dryo2 continue
diffuse time=5 temp=925 dryo2 continue
diffuse time=5 temp=975 dryo2 continue
diffuse time=20 temp=1000 dryo2 continue
diffuse time=5 temp=1000 nitrogen continue
diffuse time=10 temp=975 nitrogen continue
diffuse time=10 temp=925 nitrogen continue
diffuse time=10 temp=875 nitrogen continue
diffuse time=10 temp=825 nitrogen continue
diffuse time=15 temp=800 nitrogen continue
structure outfile=annealed.str
# PDF p.117/118: use 0.5 um ILD, despite p.17 summary 0.4 um.
deposit oxide thick=0.5 divisions=10 space=0.06
deposit photoresist file=resist_top.dat divisions=8
etch photoresist start x=0.75 y=-5
etch continue x=0.75 y=1
etch continue x=1.75 y=1
etch done x=1.75 y=-5
etch photoresist start x=3.75 y=-5
etch continue x=3.75 y=1
etch continue x=4.75 y=1
etch done x=4.75 y=-5
etch photoresist start x=5.55 y=-5
etch continue x=5.55 y=1
etch continue x=6.45 y=1
etch done x=6.45 y=-5
etch photoresist start x=7.25 y=-5
etch continue x=7.25 y=1
etch continue x=8.25 y=1
etch done x=8.25 y=-5
etch oxide dry thick=1.5
etch photoresist all
structure outfile=contacts.str
deposit aluminum thick=0.75 divisions=10 space=0.06
etch aluminum start x=-0.1 y=-6
etch continue x=-0.1 y=1
etch continue x=0.5 y=1
etch done x=0.5 y=-6
etch aluminum start x=2 y=-6
etch continue x=2 y=1
etch continue x=3.4 y=1
etch done x=3.4 y=-6
etch aluminum start x=5 y=-6
etch continue x=5 y=1
etch continue x=5.25 y=1
etch done x=5.25 y=-6
etch aluminum start x=6.75 y=-6
etch continue x=6.75 y=1
etch continue x=7 y=1
etch done x=7 y=-6
etch aluminum start x=8.8 y=-6
etch continue x=8.8 y=1
etch continue x=10.1 y=1
etch done x=10.1 y=-6
structure outfile=metal1.str
structure outfile=nmos.str
quit
