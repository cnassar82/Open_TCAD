# RIT Sub-CMOS 2014: PMOS, isolated well cross-section.
# Source: rit_process/SubCmos2014_0p5um.pdf; see README.md.
# 1 um drawn gate (0.5 um layout lambda); assumed 2D masks.
option quiet
method fermi vertical grid.oxide=0.04
line x loc=0 spac=0.2 tag=left
line x loc=0.5 spac=0.08
line x loc=2 spac=0.08
line x loc=3 spac=0.08
line x loc=5 spac=0.06
line x loc=5.5 spac=0.04
line x loc=6 spac=0.06
line x loc=6.5 spac=0.04
line x loc=7 spac=0.06
line x loc=9 spac=0.08
line x loc=10 spac=0.2 tag=right
line y loc=0 spac=0.01 tag=top
line y loc=0.1 spac=0.025
line y loc=0.4 spac=0.08
line y loc=1 spac=0.2
line y loc=3 spac=0.4
line y loc=8 spac=0.8 tag=bottom
region silicon xlo=left xhi=right ylo=top yhi=bottom
boundary exposed xlo=left xhi=right ylo=top yhi=top
boundary backside xlo=left xhi=right ylo=bottom yhi=bottom
initialize boron conc=1e15 orient=100
structure outfile=initial.str
# PDF p.24: 250 pad oxide; ramps discretized in <=50 C intervals.
diffuse time=12 temp=800 nitrogen
diffuse time=15 temp=800 nitrogen continue
diffuse time=5 temp=825 dryo2
diffuse time=5 temp=875 dryo2 continue
diffuse time=5 temp=925 dryo2 continue
diffuse time=5 temp=975 dryo2 continue
diffuse time=40 temp=1000 dryo2 continue
diffuse time=5 temp=1000 nitrogen continue
diffuse time=10 temp=975 nitrogen continue
diffuse time=10 temp=925 nitrogen continue
diffuse time=10 temp=875 nitrogen continue
diffuse time=10 temp=825 nitrogen continue
diffuse time=12 temp=800 nitrogen continue
structure outfile=pad.str
deposit nitride thick=0.15 divisions=5
etch nitride all
implant phosphorus dose=9.5e+12 energy=125 pearson
# PDF p.43: 330 n-well masking oxide; ramps discretized in <=50 C intervals.
diffuse time=12 temp=800 nitrogen
diffuse time=15 temp=800 nitrogen continue
diffuse time=5 temp=825 nitrogen continue
diffuse time=5 temp=875 nitrogen continue
diffuse time=5 temp=925 nitrogen continue
diffuse time=5 temp=975 nitrogen continue
diffuse time=5 temp=1000 dryo2
diffuse time=50 temp=1000 weto2 continue
diffuse time=5 temp=1000 nitrogen continue
diffuse time=10 temp=975 nitrogen continue
diffuse time=10 temp=925 nitrogen continue
diffuse time=10 temp=875 nitrogen continue
diffuse time=10 temp=825 nitrogen continue
diffuse time=12 temp=800 nitrogen continue
# PDF p.48: 25 nm oxide loss in pre-strip BOE.
etch oxide dry thick=0.025
implant bf2 dose=8e+12 energy=110 pearson
structure outfile=well_mask.str
# PDF p.56: 10 well drive; ramps discretized in <=50 C intervals.
diffuse time=12 temp=800 nitrogen
diffuse time=15 temp=800 nitrogen continue
diffuse time=5 temp=825 nitrogen continue
diffuse time=5 temp=875 nitrogen continue
diffuse time=5 temp=925 nitrogen continue
diffuse time=5 temp=975 nitrogen continue
diffuse time=5 temp=1025 nitrogen continue
diffuse time=5 temp=1075 nitrogen continue
diffuse time=600 temp=1100 nitrogen continue
diffuse time=5 temp=1100 nitrogen continue
diffuse time=10 temp=1075 nitrogen continue
diffuse time=10 temp=1025 nitrogen continue
diffuse time=10 temp=975 nitrogen continue
diffuse time=10 temp=925 nitrogen continue
diffuse time=10 temp=875 nitrogen continue
diffuse time=10 temp=825 nitrogen continue
diffuse time=12 temp=800 nitrogen continue
structure outfile=wells.str
etch oxide all
# PDF p.59: 250 second pad oxide; ramps discretized in <=50 C intervals.
diffuse time=12 temp=800 nitrogen
diffuse time=15 temp=800 nitrogen continue
diffuse time=5 temp=825 dryo2
diffuse time=5 temp=875 dryo2 continue
diffuse time=5 temp=925 dryo2 continue
diffuse time=5 temp=975 dryo2 continue
diffuse time=40 temp=1000 dryo2 continue
diffuse time=5 temp=1000 nitrogen continue
diffuse time=10 temp=975 nitrogen continue
diffuse time=10 temp=925 nitrogen continue
diffuse time=10 temp=875 nitrogen continue
diffuse time=10 temp=825 nitrogen continue
diffuse time=12 temp=800 nitrogen continue
deposit nitride thick=0.15 divisions=5
etch nitride start x=-0.1 y=-5
etch continue x=-0.1 y=1
etch continue x=0.5 y=1
etch done x=0.5 y=-5
etch nitride start x=2 y=-5
etch continue x=2 y=1
etch continue x=3 y=1
etch done x=3 y=-5
etch nitride start x=9 y=-5
etch continue x=9 y=1
etch continue x=10.1 y=1
etch done x=10.1 y=-5
structure outfile=locos_mask.str
quit
