GLOBAL TExternal=300 DopingScale=1e18 Z.Width=1.0
IMPORT TIFFile=device.tif
CONTACT Type=OhmicContact ID=Body Res=0 Cap=0 Ind=0
CONTACT Type=OhmicContact ID=Source Res=0 Cap=0 Ind=0
CONTACT Type=GateContact ID=Gate WorkFunction=4.17 Res=0 Cap=0 Ind=0
CONTACT Type=OhmicContact ID=Drain Res=0 Cap=0 Ind=0
BOUNDARY Type=InsulatorInterface ID=region_0_to_region_7 QF=0
BOUNDARY Type=InsulatorInterface ID=region_0_to_region_8 QF=0
BOUNDARY Type=InsulatorInterface ID=region_0_to_region_9 QF=0
BOUNDARY Type=InsulatorInterface ID=region_0_to_region_10 QF=0
PMI Region=region_0 Type=Mobility Model=Lucent
MODEL Region=region_0 Fermi=true
METHOD Type=DDML1 NS=Basic LS=MUMPS MaxIteration=80 Damping=Potential
SOLVE Type=EQUILIBRIUM
EXPORT CGNSFile=equilibrium.cgns VTKFile=equilibrium.vtu
END
