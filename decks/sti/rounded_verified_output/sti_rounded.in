# Rounded STI: 30 nm upper and 50 nm lower corner radii.
# Local 5 nm substrate spacing around the trench edges; dimensions in um.
# Geometric etchback, not a calibrated CMP model.
option quiet
line x loc=-1 spac=0.12 tag=left
line x loc=-0.4 spac=0.015
line x loc=-0.33 spac=0.005
line x loc=-0.3 spac=0.005
line x loc=-0.25 spac=0.0075
line x loc=0 spac=0.025
line x loc=0.25 spac=0.0075
line x loc=0.3 spac=0.005
line x loc=0.33 spac=0.005
line x loc=0.4 spac=0.015
line x loc=1 spac=0.12 tag=right
line y loc=0 spac=0.005 tag=top
line y loc=0.03 spac=0.005
line y loc=0.1 spac=0.015
line y loc=0.25 spac=0.01
line y loc=0.3 spac=0.005
line y loc=0.35 spac=0.005
line y loc=0.45 spac=0.02
line y loc=1 spac=0.1 tag=bottom
region silicon xlo=left xhi=right ylo=top yhi=bottom
boundary exposed xlo=left xhi=right ylo=top yhi=top
boundary backside xlo=left xhi=right ylo=bottom yhi=bottom
initialize orient=100 boron conc=1e15
structure outfile=initial.str
etch silicon start x=-0.33 y=-0.2
etch continue x=-0.33 y=0
etch continue x=-0.3260842142 y=0.0002566541588
etch continue x=-0.3222354286 y=0.001022225211
etch continue x=-0.318519497 y=0.002283614025
