etch continue x=0.3260842142 y=0.0002566541588
etch continue x=0.33 y=0
etch done x=0.33 y=-0.2
structure outfile=trench.str
method viscous oxide.rel=1e-2 grid.oxide=0.01
diffuse time=10 temp=1000 dryo2
structure outfile=liner.str
deposit oxide thick=0.4 divisions=24 space=0.01
structure outfile=filled.str
etch oxide start x=-1.1 y=-1
etch continue x=-1.1 y=0
etch continue x=1.1 y=0
etch done x=1.1 y=-1
structure outfile=sti.str
quit
