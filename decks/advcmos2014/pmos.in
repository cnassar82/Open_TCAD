# RIT Advanced CMOS 2014: PMOS, isolated well cross-section.
# Source: rit_process/AdvCmos2014_0p25um.pdf; see README.md.
# 0.5 um drawn poly gate (0.25 um lambda); assumed 2D masks.
option quiet
method fermi vertical grid.oxide=0.02
phosphorus oxide Dix.0=7.23 Dix.E=4.44
line x loc=0 spac=0.1 tag=left
line x loc=0.3 spac=0.05
line x loc=1.5 spac=0.05
line x loc=1.9 spac=0.04
line x loc=3 spac=0.08
line x loc=4.4 spac=0.02
line x loc=4.75 spac=0.01
line x loc=5 spac=0.02
line x loc=5.25 spac=0.01
line x loc=5.6 spac=0.02
line x loc=7 spac=0.08
line x loc=8.5 spac=0.04
line x loc=9.5 spac=0.1 tag=right
line y loc=0 spac=0.005 tag=top
line y loc=0.05 spac=0.01
line y loc=0.2 spac=0.02
line y loc=0.5 spac=0.05
line y loc=1 spac=0.15
line y loc=3 spac=0.4
line y loc=6 spac=0.8 tag=bottom
region silicon xlo=left xhi=right ylo=top yhi=bottom
boundary exposed xlo=left xhi=right ylo=top yhi=top
boundary backside xlo=left xhi=right ylo=bottom yhi=bottom
# PDF p.6/20: p-type 10 ohm-cm (100) substrate.
initialize boron conc=1.3e15 orient=100
structure outfile=initial.str
# PDF p.23: 500 A pad oxide, recipe 250; ramps discretized in <=50 C intervals.
diffuse time=12 temp=800 nitrogen
diffuse time=15 temp=800 nitrogen continue
diffuse time=5 temp=825 dryo2
diffuse time=5 temp=875 dryo2 continue
diffuse time=5 temp=925 dryo2 continue
diffuse time=5 temp=975 dryo2 continue
diffuse time=51 temp=1000 dryo2 continue
diffuse time=5 temp=1000 nitrogen continue
diffuse time=10 temp=975 nitrogen continue
diffuse time=10 temp=925 nitrogen continue
diffuse time=10 temp=875 nitrogen continue
diffuse time=10 temp=825 nitrogen continue
diffuse time=12 temp=800 nitrogen continue
structure outfile=pad.str
# PDF p.24: LPCVD Si3N4 1500 A.
deposit nitride thick=0.15 divisions=5
etch nitride start x=-0.1 y=-5
etch continue x=-0.1 y=1
etch continue x=0.3 y=1
etch done x=0.3 y=-5
etch nitride start x=1.5 y=-5
etch continue x=1.5 y=1
etch continue x=1.9 y=1
etch done x=1.9 y=-5
etch nitride start x=8.5 y=-5
etch continue x=8.5 y=1
etch continue x=9.6 y=1
etch done x=9.6 y=-5
structure outfile=active_mask.str
# PDF p.37: first recessed oxide, 3650 A; ramps discretized in <=50 C intervals.
diffuse time=12 temp=800 nitrogen
diffuse time=15 temp=800 nitrogen continue
diffuse time=5 temp=825 nitrogen continue
diffuse time=5 temp=875 nitrogen continue
diffuse time=5 temp=925 nitrogen continue
diffuse time=5 temp=975 nitrogen continue
diffuse time=5 temp=1025 nitrogen continue
diffuse time=5 temp=1075 nitrogen continue
diffuse time=5 temp=1100 dryo2
diffuse time=22 temp=1100 weto2 continue
diffuse time=5 temp=1100 nitrogen continue
diffuse time=9.166666667 temp=1075 nitrogen continue
diffuse time=9.166666667 temp=1025 nitrogen continue
diffuse time=9.166666667 temp=975 nitrogen continue
diffuse time=9.166666667 temp=925 nitrogen continue
diffuse time=9.166666667 temp=875 nitrogen continue
diffuse time=9.166666667 temp=825 nitrogen continue
diffuse time=12 temp=800 nitrogen continue
structure outfile=first_oxide.str
etch oxide dry thick=0.40
# PDF p.37: second recessed oxide, 3650 A; ramps discretized in <=50 C intervals.
diffuse time=12 temp=800 nitrogen
diffuse time=15 temp=800 nitrogen continue
diffuse time=5 temp=825 nitrogen continue
diffuse time=5 temp=875 nitrogen continue
diffuse time=5 temp=925 nitrogen continue
diffuse time=5 temp=975 nitrogen continue
diffuse time=5 temp=1025 nitrogen continue
diffuse time=5 temp=1075 nitrogen continue
diffuse time=5 temp=1100 dryo2
diffuse time=22 temp=1100 weto2 continue
diffuse time=5 temp=1100 nitrogen continue
diffuse time=9.166666667 temp=1075 nitrogen continue
diffuse time=9.166666667 temp=1025 nitrogen continue
diffuse time=9.166666667 temp=975 nitrogen continue
diffuse time=9.166666667 temp=925 nitrogen continue
diffuse time=9.166666667 temp=875 nitrogen continue
diffuse time=9.166666667 temp=825 nitrogen continue
diffuse time=12 temp=800 nitrogen continue
structure outfile=recessed_oxide.str
implant phosphorus dose=3e+13 energy=170 pearson
# PDF p.40: hot phosphoric acid nitride strip.
etch nitride all
# PDF p.43: well drive, recipe 11; ramps discretized in <=50 C intervals.
diffuse time=12 temp=800 nitrogen
diffuse time=15 temp=800 nitrogen continue
diffuse time=5 temp=825 nitrogen continue
diffuse time=5 temp=875 nitrogen continue
diffuse time=5 temp=925 nitrogen continue
diffuse time=5 temp=975 nitrogen continue
diffuse time=5 temp=1025 nitrogen continue
diffuse time=5 temp=1075 nitrogen continue
diffuse time=360 temp=1100 nitrogen continue
diffuse time=5 temp=1100 nitrogen continue
diffuse time=10 temp=1075 nitrogen continue
diffuse time=10 temp=1025 nitrogen continue
diffuse time=10 temp=975 nitrogen continue
diffuse time=10 temp=925 nitrogen continue
diffuse time=10 temp=875 nitrogen continue
diffuse time=10 temp=825 nitrogen continue
diffuse time=12 temp=800 nitrogen continue
structure outfile=wells.str
implant phosphorus dose=3.5e+12 energy=60 pearson
structure outfile=threshold.str
etch oxide dry thick=0.06
# PDF p.58: 100 A N2O gate oxide, recipe 213; ramps discretized in <=50 C intervals.
diffuse time=12 temp=800 nitrogen
diffuse time=30 temp=800 nitrogen continue
diffuse time=15 temp=825 dryo2
diffuse time=15 temp=875 dryo2 continue
diffuse time=30 temp=900 nitrogen continue
diffuse time=12 temp=900 dryo2
diffuse time=15 temp=875 nitrogen continue
diffuse time=15 temp=825 nitrogen continue
diffuse time=15 temp=800 nitrogen continue
structure outfile=gate_oxide.str
# PDF p.63: LPCVD poly 4000 A, undoped; doped by the D/S implants.
deposit poly thick=0.4 divisions=10 space=0.01
structure outfile=poly.str
etch poly left p1.x=4.75
etch poly right p1.x=5.25
structure outfile=gate.str
# PDF p.74: 500 A poly re-oxidation, recipe 250; ramps discretized in <=50 C intervals.
diffuse time=12 temp=800 nitrogen
diffuse time=15 temp=800 nitrogen continue
diffuse time=5 temp=825 dryo2
diffuse time=5 temp=875 dryo2 continue
diffuse time=5 temp=925 dryo2 continue
diffuse time=5 temp=975 dryo2 continue
diffuse time=51 temp=1000 dryo2 continue
diffuse time=5 temp=1000 nitrogen continue
diffuse time=10 temp=975 nitrogen continue
diffuse time=10 temp=925 nitrogen continue
diffuse time=10 temp=875 nitrogen continue
diffuse time=10 temp=825 nitrogen continue
diffuse time=12 temp=800 nitrogen continue
structure outfile=reox.str
deposit photoresist thick=1.5 divisions=6
etch photoresist start x=1.9 y=-5
etch continue x=1.9 y=1
etch continue x=8.5 y=1
etch done x=8.5 y=-5
implant boron dose=4e+13 energy=50 pearson
etch photoresist all
structure outfile=ldd.str
deposit nitride thick=0.35 divisions=10 space=0.03
etch nitride dry thick=0.37
structure outfile=spacers.str
deposit photoresist file=resist_top.dat divisions=8
etch photoresist start x=1.9 y=-5
etch continue x=1.9 y=1
etch continue x=8.5 y=1
etch done x=8.5 y=-5
implant boron dose=4e+15 energy=50 pearson
etch photoresist all
deposit photoresist file=resist_top.dat divisions=8
etch photoresist start x=0.3 y=-5
etch continue x=0.3 y=1
etch continue x=1.5 y=1
etch done x=1.5 y=-5
implant phosphorus dose=4e+15 energy=60 pearson
etch photoresist all
structure outfile=source_drain.str
# PDF p.95: D/S anneal, recipe 284; ramps discretized in <=50 C intervals.
diffuse time=12 temp=800 nitrogen
diffuse time=15 temp=800 nitrogen continue
diffuse time=5 temp=825 nitrogen continue
diffuse time=5 temp=875 nitrogen continue
diffuse time=5 temp=925 nitrogen continue
diffuse time=5 temp=975 nitrogen continue
diffuse time=20 temp=1000 nitrogen continue
diffuse time=5 temp=1000 nitrogen continue
diffuse time=10 temp=975 nitrogen continue
diffuse time=10 temp=925 nitrogen continue
diffuse time=10 temp=875 nitrogen continue
diffuse time=10 temp=825 nitrogen continue
diffuse time=15 temp=800 nitrogen continue
structure outfile=annealed.str
# PDF p.105: PECVD TEOS ILD 5000 A.
deposit oxide thick=0.5 divisions=10 space=0.05
deposit photoresist file=resist_top.dat divisions=8
etch photoresist start x=0.6 y=-5
etch continue x=0.6 y=1
etch continue x=1.2 y=1
etch done x=1.2 y=-5
etch photoresist start x=3.6 y=-5
etch continue x=3.6 y=1
etch continue x=4.2 y=1
etch done x=4.2 y=-5
etch photoresist start x=4.85 y=-5
etch continue x=4.85 y=1
etch continue x=5.15 y=1
etch done x=5.15 y=-5
etch photoresist start x=5.8 y=-5
etch continue x=5.8 y=1
etch continue x=6.4 y=1
etch done x=6.4 y=-5
etch oxide dry thick=1.5
etch photoresist all
structure outfile=contacts.str
deposit aluminum thick=0.6 divisions=10 space=0.05
etch aluminum start x=-0.1 y=-6
etch continue x=-0.1 y=1
etch continue x=0.3 y=1
etch done x=0.3 y=-6
etch aluminum start x=1.55 y=-6
etch continue x=1.55 y=1
etch continue x=2 y=1
etch done x=2 y=-6
etch aluminum start x=4.45 y=-6
etch continue x=4.45 y=1
etch continue x=4.6 y=1
etch done x=4.6 y=-6
etch aluminum start x=5.4 y=-6
etch continue x=5.4 y=1
etch continue x=5.55 y=1
etch done x=5.55 y=-6
etch aluminum start x=8.5 y=-6
etch continue x=8.5 y=1
etch continue x=9.6 y=1
etch done x=9.6 y=-6
structure outfile=metal1.str
structure outfile=pmos.str
quit
