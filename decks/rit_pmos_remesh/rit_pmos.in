#RIT METAL GATE PMOS PROCESS

line x loc=0.0  spac=1 tag=left
line x loc=150.0  spac=1 tag=right
line y loc=0.0  spac=0.0005 tag=surf
line y loc=2  spac=0.2
line y loc=10  spac=3  tag=back

# (Removed boron Dip.0=0.5 and Seg.0=640 — those were compensating for the
# implant bug where setprs(B, SiO2) silently aborted because canonical
# sup4gs.imp had no B-in-SiO2 entries AND setprs did not translate the
# SUPREM-IV SiO2=1 code to the SUPREM-III oxide=5 code used in the .imp
# file. Fixed in src/implant/{imp_setprs.c,pearson.c} + data/sup4gs.imp.)

region silicon xlo=left xhi=right ylo=surf yhi=back
boundary exposed  xlo=left xhi=right ylo=surf yhi=surf
boundary backsid xlo=left xhi=right ylo=back  yhi=back

initialize phosphorus conc=3e14

#------------------------------------------------
#6500A Oxide Growth


diffuse time=5 temp=1100 dryo2 
diffuse time=57 temp=1100 weto2 continue
diffuse time=5 temp=1100 nitrogen continue
structure outfile=inital_ox.str
#------------------------------------------------
#Pattern Level #1 Diffusion
deposit photores thick=1.0 divisions=5

etch photores start   x=10.0 y=-5.0
etch continue         x=10.0 y=5.0
etch continue         x=60.0 y=5
etch done             x=60.0 y=-5

etch photores start   x=80.0 y=-5.0
etch continue         x=80.0 y=5.0
etch continue         x=130.0 y=5
etch done             x=130.0 y=-5

etch oxide dry thick=1

structure outfile=diffusion_photo_etch.str angle=7

etch photores all

# Densify the oxide mesh before the implant so the Pearson peak (drp ~60 nm,
# centered ~Rp=0.22 um inside the 0.66 um oxide) is sampled by enough nodes
# to integrate the deposit correctly. Without this, SUPREM has only ~1
# vertical oxide node per x position and dose-conservation drops to ~26 %
# of the theoretical 2e15/cm^2 x non-window-width in oxide regions.
# Engine: tools/refine_oxide.py (structured column triangulation, gmsh-free).
# remesh mode=refine-oxide layers=4 boundary-buffer=0.02

# Boron diffusion + segregation tuning to match Silvaco.
# `Dip.0` is the B+ pair diffusion pre-exponential and is the dominant
# diffusion knob in p-type silicon (modelrc default 0.76 gives junction depth
# 2.135 um at x=35 after the 4000A oxide grow; Silvaco gives 1.892 um).
# A 1-D sweep showed Dip.0=0.48 lands junction = 1.890 um (-0.12 % error).
# A 2-D Seg.0 x Trn.0 sweep at fixed Dip.0=0.48 showed Seg.0=100, Trn.0=1e-5
# also matches Silvaco's Si-side dose (1.00e13 vs 9.75e12, +2.7 %).
# Placed AFTER the `# remesh` marker so it lands in the chunk that contains
# the implant + diffusion steps; if put before the marker, the chunk split
# in bin/remesh would put it in the pre-remesh chunk and it'd be ignored.
boron silicon Dip.0=0.48
boron silicon /oxide Seg.0=100
boron silicon /oxide Trn.0=1e-5

#------------------------------------------------
#Implant Boron
implant boron dose=2e15 energy=75 pearson
structure outfile=diffusion_implant.str
#------------------------------------------------
#4000A Oxide Growth

method fermi
diffuse time=5 temp=1100 dryo2 
diffuse time=20 temp=1100 weto2 continue
diffuse time=5 temp=1100 nitrogen continue
structure outfile=4000_ox.str

# Refine oxide again now that the 4000A oxide has grown — keeps the oxide
# mesh dense enough that the next thermal step (700A wet O2 at 1000 C below)
# can converge with the sharper boron gradient produced by Dip.0=0.48.
# Without this, SUPREM's grid mutation hits sliver triangles during the
# 1000 C diffuse and segfaults.
# remesh mode=refine-oxide layers=4 boundary-buffer=0.02

#------------------------------------------------
#Pattern Gate Oxide Region
deposit photores thick=1.0 divisions=5

etch photores start   x=50.0 y=-5.0
etch continue         x=50.0 y=5.0
etch continue         x=90.0 y=5
etch done             x=90.0 y=-5

etch oxide dry thick=1
etch photores all
#700A Oxide Growth

# Re-apply the tuned parameters in this chunk too (remesh splits the deck,
# and parameter overrides don't carry across chunks).
boron silicon Dip.0=0.48
boron silicon /oxide Seg.0=100
boron silicon /oxide Trn.0=1e-5

diffuse time=95 temp=1000 dryo2

structure outfile=700_ox.str

#------------------------------------------------
#Contact Etch

deposit photores thick=1.8

etch photores start   x=20.0 y=-5.0
etch continue         x=20.0 y=5.0
etch continue         x=30.0 y=5
etch done             x=30.0 y=-5

etch photores start   x=110 y=-5.0
etch continue         x=110 y=5.0
etch continue         x=119.5 y=5
etch done             x=119.5 y=-5

etch oxide dry thick=1

etch photores all

structure outfile=cont_etch.str

#------------------------------------------------
#Deposit Metal

deposit alumin thick=1 divisions=10

structure outfile=dep_alumin.str

#------------------------------------------------
#Etch Metal

etch alumin start   x=50.0 y=-5.0
etch continue         x=50.0 y=5.0
etch continue         x=60.0 y=5
etch done             x=60.0 y=-5

etch alumin start   x=80 y=-5.0
etch continue         x=80 y=5.0
etch continue         x=90 y=5
etch done             x=90 y=-5

#structure outfile=pr_etch_alumin.str

#etch alumin dry thick=1.2

structure outfile=etch_alumin.str

#etch photores all

structure outfile=pmos.str












